# ── WhatsApp Cloud API (Meta for Developers) ──────────────────────────────
# Phone Number ID: WhatsApp → API Setup → Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=

# Access Token permanente (sin expiración): Meta Business Suite → System Users → Generate Token
WHATSAPP_ACCESS_TOKEN=

# Token de verificación del webhook: cualquier cadena, la misma que pondrás en Meta
WHATSAPP_VERIFY_TOKEN=

# App Secret: Meta for Developers → App → Settings → Basic → App Secret
# Opcional pero recomendado: activa verificación HMAC de cada petición entrante
WHATSAPP_APP_SECRET=

# ── Google Calendar ────────────────────────────────────────────────────────
# ID del calendario: Google Calendar → Settings → Integrate Calendar → Calendar ID
GOOGLE_CALENDAR_ID=

# Ruta al fichero de credenciales de la Service Account de Google Cloud
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Admin ──────────────────────────────────────────────────────────────────
# Número del administrador en formato internacional sin + ni espacios
# Ej: 34612345678 — recibe alertas del watchdog y puede usar el comando /estado
ADMIN_PHONE=

# ── Logs ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=/var/log/peluqueria/app.log

# ── Watchdog (opcionales, tienen valores por defecto) ─────────────────────
# Porcentaje de RAM a partir del cual se alerta (defecto: 90)
WATCHDOG_RAM_CRITICAL_PCT=90
# Porcentaje de disco a partir del cual se alerta (defecto: 90)
WATCHDOG_DISK_CRITICAL_PCT=90
# Errores nuevos en /metrics para disparar alerta de spike (defecto: 3)
WATCHDOG_ERROR_SPIKE_THRESHOLD=3

# ── Ngrok (solo si usas modo ngrok como túnel) ────────────────────────────
# Dominio estático de tu cuenta: dashboard.ngrok.com → Domains
NGROK_DOMAIN=
# Auth Token de ngrok: dashboard.ngrok.com → Your Authtoken
NGROK_TOKEN=
